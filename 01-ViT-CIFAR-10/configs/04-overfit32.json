{
  "stage": "04-overfit32",
  "seed": 42,
  "cpu_threads": 4,
  "batch_size": 32,
  "subset_selection": "first_32_saved_train_indices",
  "forward_config": "02-forward.json",
  "precision": "float32_ieee",
  "deterministic_algorithms": true,
  "optimizer": {
    "lr": 0.0003,
    "betas": [0.9, 0.999],
    "eps": 1e-8,
    "weight_decay": 0.0,
    "foreach": false,
    "fused": false
  },
  "max_steps": 1000,
  "evaluate_every": 10,
  "target": {
    "accuracy": 1.0,
    "loss_at_most": 0.05,
    "consecutive_evaluations": 3
  }
}
